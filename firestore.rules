rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    match /reviews/{reviewId} {
      function isValidReview(data) {
        return data.userName is string && data.userName.size() <= 100
            && data.rating is number && data.rating >= 1 && data.rating <= 5
            && data.status in ['pending', 'approved', 'rejected']
            && data.createdAt is timestamp;
      }

      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isAdmin();
      allow read, list: if resource.data.status == 'approved' || isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
    }
  }
}

